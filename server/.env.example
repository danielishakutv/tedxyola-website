# Copy to .env and fill in. Never commit .env.
ADMIN_PASSWORD=change-me-to-something-long
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long

# Optional: machine-to-machine API key. If set, requests with
#   Authorization: Bearer <API_KEY>
# are treated as admin (no login flow). Leave blank to disable.
API_KEY=

# Optional: comma-separated browser origins allowed to call the API
# (e.g. https://app.tedxyola.com,https://example.com). Leave blank for
# same-origin only.
CORS_ORIGINS=

PUBLIC_BASE_URL=https://tedxyola.com
SHORT_PREFIX=/s
PORT=3001
NODE_ENV=production
